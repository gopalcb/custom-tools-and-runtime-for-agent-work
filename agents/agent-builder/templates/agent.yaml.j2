id: {{ spec.id }}
version: {{ spec.version }}
description: {{ spec.description | tojson }}
purpose: {{ spec.purpose | tojson }}
instructions_file: AGENT.md
skills_file: skills.yaml
evals_file: evals.yaml
runtime:
  provider: {{ spec.runtime.provider }}
  model: {{ spec.runtime.model | tojson }}
  sandbox: {{ spec.runtime.sandbox }}
  workspace: {{ spec.runtime.workspace }}
permissions:
  filesystem_read:
{% for item in spec.permissions.filesystem_read %}    - {{ item | tojson }}
{% endfor %}  filesystem_write:
{% for item in spec.permissions.filesystem_write %}    - {{ item | tojson }}
{% endfor %}  shell: {{ spec.permissions.shell | lower }}
  network: {{ spec.permissions.network }}
