{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "title", "summary", "assumptions", "architecture", "implementation", "testing", "risks", "done_criteria"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "architecture": {
      "type": "object",
      "required": ["overview", "tree", "components", "data_flow"],
      "properties": {
        "overview": {"type": "string"},
        "tree": {"type": "string", "minLength": 1},
        "components": {"type": "array", "items": {"type": "object"}},
        "data_flow": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["phases", "execution_groups"],
      "properties": {
        "phases": {"type": "array", "items": {"type": "object"}},
        "execution_groups": {"type": "array", "items": {"type": "object"}}
      }
    },
    "testing": {"type": "array"},
    "risks": {"type": "array"},
    "done_criteria": {"type": "array", "items": {"type": "string"}}
  }
}
