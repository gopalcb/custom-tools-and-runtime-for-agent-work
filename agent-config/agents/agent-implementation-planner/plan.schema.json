{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "title", "summary", "assumptions", "tasks", "architecture", "implementation", "testing", "risks", "done_criteria"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "description", "files", "depends_on", "acceptance_criteria"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable task name used as the markdown file stem."
          },
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["overview", "tree", "components", "data_flow"],
      "additionalProperties": false,
      "properties": {
        "overview": {"type": "string", "minLength": 1},
        "tree": {"type": "string", "minLength": 1},
        "components": {"type": "array", "items": {"type": "object"}},
        "data_flow": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["phases", "execution_groups"],
      "additionalProperties": false,
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "goal", "tasks"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "goal": {"type": "string", "minLength": 1},
              "tasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "description", "files"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "description": {"type": "string", "minLength": 1},
                    "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "depends_on": {"type": "array", "items": {"type": "string"}},
                    "dependencies": {"type": "array", "items": {"type": "string"}},
                    "parallelizable": {"type": "boolean"},
                    "details": {"type": "array", "items": {"type": "string"}},
                    "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        },
        "execution_groups": {"type": "array", "items": {"type": "object"}}
      }
    },
    "testing": {"type": "array"},
    "risks": {"type": "array"},
    "done_criteria": {"type": "array", "items": {"type": "string"}}
  }
}
