{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-work-health.py\"",
            "timeout": 60,
            "statusMessage": "Checking monorepo agent system health"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/start-controller.mjs\"",
            "timeout": 120,
            "statusMessage": "Ensuring monorepo controller is running"
          }
        ]
      }
    ]
  }
}
