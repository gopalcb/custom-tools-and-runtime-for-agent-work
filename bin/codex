#!/usr/bin/env bash
set -e

WRAPPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/codex"

if [ -n "${CODEX_NATIVE_BIN:-}" ] && [ "$CODEX_NATIVE_BIN" != "$WRAPPER" ] && [ -x "$CODEX_NATIVE_BIN" ]; then
    exec "$CODEX_NATIVE_BIN" "$@"
fi

IFS=:
for directory in $PATH; do
    candidate="$directory/codex"
    if [ "$candidate" != "$WRAPPER" ] && [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done
unset IFS

echo "Unable to locate native Codex CLI. Set CODEX_NATIVE_BIN to the native executable." >&2
exit 1
